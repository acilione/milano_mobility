# Copy this file to .env. Values are safe development defaults only.
COMPOSE_PROJECT_NAME=milano-mobility

POSTGRES_DB=mobility
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres
INGESTION_DB_USER=ingestion_writer
INGESTION_DB_PASSWORD=ingestion_dev
TRANSFORMER_DB_USER=transformer
TRANSFORMER_DB_PASSWORD=transformer_dev
BI_DB_USER=bi_reader
BI_DB_PASSWORD=bi_reader_dev
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_dev
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=metabase_dev

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_dev_password
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev_password
S3_RAW_BUCKET=raw
S3_QUARANTINE_BUCKET=quarantine
S3_CURATED_BUCKET=curated

AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=local-development-only

GTFS_SOURCE_URL=https://dati.comune.milano.it/gtfs.zip
GTFS_SOURCE_NAME=comune_milano_official_gtfs
GTFS_REQUEST_TIMEOUT_SECONDS=120
DBT_THREADS=1
SERVICE_AREA_ID=milano
SERVICE_AREA_LATITUDE=45.4642
SERVICE_AREA_LONGITUDE=9.1900
GTFS_TIME_TOLERANCE_SECONDS=300
GTFS_INVALID_COORDINATE_THRESHOLD=0.005
